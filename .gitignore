# Tokens y sesiones
.token_cache.json
.token_cache.*.tmp
.teams_session*/
.ts_*/
.env
*.env

# Python
*.pyc
__pycache__/
.venv/

# Temporales
assets/portada_*.png
.DS_Store
*.tmp.json

# Sandbox (tareas y entregas locales)
sandbox/

# Entregas legacy (scripts one-off escriben en entregas/)
entregas/

# Documentos generados (no versionar PDFs/DOCX de tareas)
*.pdf
*.docx

# Assets generados
assets/*.png
# Excepción: el logo institucional SÍ se versiona (la portada lo busca
# en config.json -> escuela.logo = assets/logo_utm.png; en clon fresco
# sin él la portada cae al texto "UTM").
!assets/logo_utm.png
!assets/.gitkeep

# Scripts auxiliares one-off
tareas_teams.json
