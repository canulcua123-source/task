# Copia este archivo a .env y completa tus valores. Nunca commitees .env
# (está en .gitignore).
# Correo escolar para el login automático de Teams (teams_auto.py).
TEAMS_EMAIL=
# Contraseña de Teams. Preferible dejarla vacía y escribirla cuando se pida
# (getpass); solo úsala en .env en un equipo personal, nunca compartido.
TEAMS_PASSWORD=
